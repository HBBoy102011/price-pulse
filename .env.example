# ============================================================================
# PricePulse — пример конфигурации.
# Скопируйте файл в .env и заполните значения: cp .env.example .env
# ============================================================================

# --- Приложение -------------------------------------------------------------
APP_NAME=PricePulse
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- База данных ------------------------------------------------------------
# SQLite (по умолчанию). Файл создаётся автоматически.
DATABASE_URL=sqlite:///./pricepulse.db
# PostgreSQL для Docker / продакшена:
# DATABASE_URL=postgresql+psycopg://pricepulse:pricepulse@db:5432/pricepulse

# Создавать таблицы при старте (удобно локально; в продакшене — Alembic).
AUTO_CREATE_TABLES=true

# --- Публичный адрес --------------------------------------------------------
# Нужен для ссылок на встроенный демо-магазин.
PUBLIC_BASE_URL=http://localhost:8000

# Разрешённые источники для CORS: * или список через запятую.
CORS_ORIGINS=*

# --- Планировщик ------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Moscow
CHECK_INTERVAL_HOURS=6
# Минимальный интервал между проверками одного товара (минуты).
MIN_CHECK_INTERVAL_MINUTES=30

# --- Парсеры ----------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENT_CHECKS=3
# Пауза между запросами к магазинам, секунды.
REQUEST_DELAY_SECONDS=0.4
# После стольких ошибок подряд товар получает статус "error".
ERROR_THRESHOLD=3
# Уважать robots.txt (рекомендуется оставить true).
ROBOTS_CHECK_ENABLED=true

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather и chat_id получателя.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
# Telegram ID пользователя по умолчанию (необязательно).
DEFAULT_USER_TELEGRAM_ID=
